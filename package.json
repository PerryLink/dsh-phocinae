{
  "name": "dsh-phocinae",
  "description": "Local non-generative decision layer for DeepSeek Harness: the phocinae_ask / phocinae_gate tools backed by a Phocinae-Largha-150M-v1 server, plus a fail-closed approval gate on tools/pre-execute with a calibrated-confidence escalation signal",
  "version": "0.2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/PerryLink/dsh-phocinae.git"
  },
  "homepage": "https://github.com/PerryLink/dsh-phocinae#readme",
  "bugs": {
    "url": "https://github.com/PerryLink/dsh-phocinae/issues"
  },
  "author": "PerryLink",
  "type": "module",
  "main": "./index.mjs",
  "types": "./types.d.ts",
  "exports": {
    ".": {
      "types": "./types.d.ts",
      "default": "./index.mjs"
    },
    "./lib/protocol.mjs": "./lib/protocol.mjs",
    "./lib/guard.mjs": "./lib/guard.mjs",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "tools.mjs",
    "types.d.ts",
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README-zh.md",
    "README-es.md",
    "README-pt.md",
    "README-hi.md",
    "ARCHITECTURE.md",
    "CHANGELOG.md",
    "SECURITY.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "phocinae",
    "decision-model",
    "approval-gate",
    "pre-tool-use",
    "escalation",
    "tool-routing",
    "local-inference",
    "cordis-plugin"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.1.6-0 <0.2.0 || >=0.2.0-0 <0.3.0"
  },
  "scripts": {
    "test": "node --test \"test/*.test.mjs\"",
    "test:integration": "node test/integration/gate-over-http.mjs && node test/integration/boot-headless.mjs",
    "bench:gate": "node bench/gate-bench.mjs",
    "bench:formulations": "node bench/formulation-bench.mjs && node bench/separation.mjs",
    "verify:artifacts": "node scripts/verify-artifacts.mjs",
    "check:readmes": "node scripts/check-readme-sync.mjs",
    "prepack": "npm test"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "^4.0.5-alpha.1"
  },
  "license": "Apache-2.0",
  "funding": {
    "type": "individual",
    "url": "https://github.com/sponsors/PerryLink"
  }
}
